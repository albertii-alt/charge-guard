    <!-- OnboardingScreen UI -->
    <string name="onboarding_title">Before you start</string>
    <string name="onboarding_intro">ChargeGuard runs in the background to alert you when your battery reaches your target level. On MIUI devices, a few extra steps are needed to prevent the system from killing the app.</string>
    <string name="onboarding_status_done">Done</string>
    <string name="onboarding_btn_open">Open Settings</string>
    <string name="onboarding_btn_continue">Continue</string>

    <!-- Onboarding step 1: Notification permission -->
    <string name="onboarding_notif_title">Notification permission</string>
    <string name="onboarding_notif_desc">Required to show charge alerts.</string>
    <string name="onboarding_notif_btn">Grant permission</string>

    <!-- Onboarding step 2: Battery optimisation exemption -->
    <string name="onboarding_battery_opt_title">Battery optimisation exemption</string>
    <string name="onboarding_battery_opt_desc">Prevents Android from suspending the monitoring service.</string>

    <!-- Onboarding step 3: MIUI Autostart -->
    <string name="onboarding_autostart_title">MIUI Autostart</string>
    <string name="onboarding_autostart_desc">Allows ChargeGuard to restart automatically after a reboot. Please confirm this is enabled manually after opening the screen.</string>
    <string name="onboarding_autostart_manual">Please confirm manually</string>

    <!-- Onboarding step 4: MIUI battery saver -->
    <string name="onboarding_miui_battery_title">MIUI battery saver — No restrictions</string>
    <string name="onboarding_miui_battery_desc">Set ChargeGuard to "No restrictions" in App battery saver to prevent MIUI from killing it. Please confirm manually after opening the screen.</string>
    <string name="onboarding_miui_battery_manual">Please confirm manually</string>

    <!-- Onboarding step 5: Lock in Recents -->
    <string name="onboarding_recents_title">Lock app in Recents</string>
    <string name="onboarding_recents_desc">In the Recents screen, swipe down on the ChargeGuard card to lock it. This prevents MIUI from closing it when you clear all apps. No button needed — do this manually.</string>
